<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_ConsultaCep"
                   targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:error id="Error_ViaCepIndisponivel" name="ViaCepIndisponivel" errorCode="VIACEP_INDISPONIVEL" />

  <bpmn:process id="consultaCepProcess" name="Consulta CEP (ViaCEP)" isExecutable="true"
                camunda:historyTimeToLive="180">

    <bpmn:startEvent id="StartEvent_ConsultaCep" name="Início">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" expression="${execution.setVariable('viacep_retry_count', 0)}" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_InicioParaConsultar</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ConsultarViaCep" name="Consultar ViaCEP"
                       camunda:delegateExpression="${viaCepDelegate}">
      <bpmn:incoming>Flow_InicioParaConsultar</bpmn:incoming>
      <bpmn:incoming>Flow_TimerParaConsultar</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsultarParaFim</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_ViaCepIndisponivel" name="Falha técnica" attachedToRef="Task_ConsultarViaCep">
      <bpmn:outgoing>Flow_ErroParaGateway</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ViaCep" errorRef="Error_ViaCepIndisponivel" />
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gateway_EsgotouTentativas" name="Esgotou as 5 tentativas?"
                            default="Flow_GatewayParaDesistir">
      <bpmn:incoming>Flow_ErroParaGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayParaTimer</bpmn:outgoing>
      <bpmn:outgoing>Flow_GatewayParaDesistir</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="TimerCatch_Aguardar15s" name="Aguarda 15s">
      <bpmn:incoming>Flow_GatewayParaTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerParaConsultar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_Fim" name="Fim">
      <bpmn:incoming>Flow_ConsultarParaFim</bpmn:incoming>
      <bpmn:incoming>Flow_GatewayParaDesistir</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_InicioParaConsultar" sourceRef="StartEvent_ConsultaCep" targetRef="Task_ConsultarViaCep" />
    <bpmn:sequenceFlow id="Flow_ConsultarParaFim" sourceRef="Task_ConsultarViaCep" targetRef="EndEvent_Fim" />
    <bpmn:sequenceFlow id="Flow_ErroParaGateway" sourceRef="Boundary_ViaCepIndisponivel" targetRef="Gateway_EsgotouTentativas" />

    <bpmn:sequenceFlow id="Flow_GatewayParaTimer" name="Não" sourceRef="Gateway_EsgotouTentativas" targetRef="TimerCatch_Aguardar15s">
      <bpmn:extensionElements>
        <camunda:executionListener event="take" expression="${execution.setVariable('viacep_retry_count', viacep_retry_count + 1)}" />
      </bpmn:extensionElements>
      <!-- viacep_retry_count conta quantas VEZES JA RETENTAMOS (comeca em 0 = primeira
           tentativa ainda nao contada como retry). Limitar a 4 aqui garante no maximo
           5 tentativas totais (1 inicial + 4 retentativas). -->
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${viacep_retry_count &lt; 4}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_GatewayParaDesistir" name="Sim (desiste)" sourceRef="Gateway_EsgotouTentativas" targetRef="EndEvent_Fim">
      <bpmn:extensionElements>
        <camunda:executionListener event="take" expression="${execution.setVariable('endereco_encontrado', false)}" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_TimerParaConsultar" sourceRef="TimerCatch_Aguardar15s" targetRef="Task_ConsultarViaCep" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ConsultaCep">
    <bpmndi:BPMNPlane id="BPMNPlane_ConsultaCep" bpmnElement="consultaCepProcess">

      <bpmndi:BPMNShape id="StartEvent_ConsultaCep_di" bpmnElement="StartEvent_ConsultaCep">
        <omgdc:Bounds x="152" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="159" y="243" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConsultarViaCep_di" bpmnElement="Task_ConsultarViaCep">
        <omgdc:Bounds x="250" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Boundary_ViaCepIndisponivel_di" bpmnElement="Boundary_ViaCepIndisponivel">
        <omgdc:Bounds x="282" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="245" y="270" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_EsgotouTentativas_di" bpmnElement="Gateway_EsgotouTentativas" isMarkerVisible="true">
        <omgdc:Bounds x="275" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="207" y="330" width="62" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TimerCatch_Aguardar15s_di" bpmnElement="TimerCatch_Aguardar15s">
        <omgdc:Bounds x="432" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="415" y="375" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Fim_di" bpmnElement="EndEvent_Fim">
        <omgdc:Bounds x="562" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="571" y="243" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_InicioParaConsultar_di" bpmnElement="Flow_InicioParaConsultar">
        <omgdi:waypoint x="188" y="218" />
        <omgdi:waypoint x="250" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ConsultarParaFim_di" bpmnElement="Flow_ConsultarParaFim">
        <omgdi:waypoint x="350" y="218" />
        <omgdi:waypoint x="562" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ErroParaGateway_di" bpmnElement="Flow_ErroParaGateway">
        <omgdi:waypoint x="300" y="276" />
        <omgdi:waypoint x="300" y="325" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GatewayParaTimer_di" bpmnElement="Flow_GatewayParaTimer">
        <omgdi:waypoint x="325" y="350" />
        <omgdi:waypoint x="432" y="350" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="370" y="332" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GatewayParaDesistir_di" bpmnElement="Flow_GatewayParaDesistir">
        <omgdi:waypoint x="300" y="325" />
        <omgdi:waypoint x="300" y="120" />
        <omgdi:waypoint x="580" y="120" />
        <omgdi:waypoint x="580" y="200" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="400" y="102" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_TimerParaConsultar_di" bpmnElement="Flow_TimerParaConsultar">
        <omgdi:waypoint x="450" y="332" />
        <omgdi:waypoint x="450" y="90" />
        <omgdi:waypoint x="300" y="90" />
        <omgdi:waypoint x="300" y="178" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
